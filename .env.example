# Copy to .env and fill in. NEVER commit .env — it is git-ignored.
# Put real values ONLY in .env; this template stays as placeholders.
# ---------- local infra ----------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio
AIRFLOW_PG_PASSWORD=change-me-pg
AIRFLOW_FERNET_KEY=            # python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_WEBSERVER_SECRET=change-me-secret
AIRFLOW_ADMIN_PASSWORD=change-me-admin
MARQUEZ_PG_PASSWORD=change-me-marquez
GRAFANA_ADMIN_PASSWORD=change-me-grafana
VAULT_DEV_TOKEN=dev-only-token
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ---------- dbt / Soda (read by profiles.yml / configuration.yml via env_var) ----------
# NOTE: defined BEFORE the connection URIs below — docker compose only
# interpolates ${VARS} that are already defined earlier in this file.
SNOWFLAKE_ACCOUNT=xy12345
SNOWFLAKE_USER=TRANSFORMER_SVC
SNOWFLAKE_PASSWORD=change-me-sf
SNOWFLAKE_ROLE=TRANSFORMER_ROLE
SNOWFLAKE_WAREHOUSE=TRANSFORM_WH
SNOWFLAKE_DATABASE=ANALYTICS_DB

# ---------- Airflow connection URIs (built from the values above) ----------
# Keep the password inside AIRFLOW_CONN_MINIO_S3 in sync with MINIO_ROOT_PASSWORD.
AIRFLOW_CONN_SNOWFLAKE_DEFAULT=snowflake://LOADER_SVC:${SNOWFLAKE_PASSWORD}@/?account=xy12345&warehouse=LOAD_WH&database=ANALYTICS_DB&role=LOADER_ROLE
AIRFLOW_CONN_MINIO_S3=aws://minioadmin:change-me-minio@/?endpoint_url=http%3A%2F%2Fminio%3A9000
